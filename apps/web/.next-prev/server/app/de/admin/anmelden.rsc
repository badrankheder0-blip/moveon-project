ras.hint":"Etagen ohne Aufzug, Zusatzleistungen, Team und Samstag.","pricing.group.terms":"Rabatte, Steuer & Bedingungen","pricing.group.terms.hint":"Gilt für jedes Angebot, nachdem alle Positionen addiert sind.","pricing.group.duration":"Zeitschätzung","pricing.group.duration.hint":"Kein Preis: bestimmt, ob ein Auftrag einen zweiten Tag belegt.","pricing.rate.per_km":"Preis pro km","pricing.rate.per_km.hint":"Für Strecken bis zur Fernumzug-Grenze.","pricing.rate.per_km_long_distance":"Preis pro km (Fernumzug)","pricing.rate.per_km_long_distance.hint":"Ab der Fernumzug-Grenze, für die ganze Strecke.","pricing.rate.long_distance_from_km":"Fernumzug ab","pricing.rate.long_distance_from_km.hint":"Ab dieser Strecke gilt der Fernumzug-Preis.","pricing.rate.base_rate_moving":"Grundpreis Umzug","pricing.rate.base_rate_moving.hint":"Fester Anteil jedes Umzugs.","pricing.rate.base_rate_disposal":"Grundpreis Entrümpelung","pricing.rate.base_rate_disposal.hint":"Fester Anteil jeder Entrümpelung.","pricing.rate.base_rate_cleaning":"Grundpreis Reinigung","pricing.rate.base_rate_cleaning.hint":"Fester Anteil jeder Reinigung.","pricing.rate.per_sqm_moving":"Umzug pro m²","pricing.rate.per_sqm_moving.hint":"Wohnfläche × dieser Preis.","pricing.rate.per_sqm_disposal":"Entrümpelung pro m²","pricing.rate.per_sqm_disposal.hint":"Fläche × dieser Preis.","pricing.rate.per_sqm_cleaning":"Reinigung pro m²","pricing.rate.per_sqm_cleaning.hint":"Zu reinigende Fläche × dieser Preis.","pricing.rate.floor_surcharge_percent":"Etagenzuschlag","pricing.rate.floor_surcharge_percent.hint":"Je Etage ohne Aufzug, auf Grundpreis und Umfang.","pricing.rate.packing_service":"Packservice","pricing.rate.packing_service.hint":"Pauschale inklusive Material.","pricing.rate.parking_zone":"Halteverbotszone","pricing.rate.parking_zone.hint":"Pauschale für Antrag und Schilder.","pricing.rate.transport_insurance_percent":"Transportversicherung","pricing.rate.transport_insurance_percent.hint":"Anteil von Grundpreis